# Copy only for local development. Never commit real values.
COMMUNITY_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
COMMUNITY_TURNSTILE_HOSTNAMES=localhost
COMMUNITY_TURNSTILE_TEST_MODE=true
COMMUNITY_CHALLENGE_LIMIT=20
